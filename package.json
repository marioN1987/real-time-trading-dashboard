{
  "name": "real-time-trading-dashboard",
  "version": "1.0.0",
  "description": "Build real-time trading dashboard with React, TypeScript, TailwindCSS, Vite and WebSocket",
  "main": "server/mock-market-data-server.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:server": "node server/mock-market-data-server.js",
    "test": "vitest",
    "lint": "eslint .",
    "start": "npm run lint && npm run test -- --run && npm run build && concurrently -k -n server,client \"npm run dev:server\" \"npm run dev\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marioN1987/real-time-trading-dashboard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/marioN1987/real-time-trading-dashboard/issues"
  },
  "homepage": "https://github.com/marioN1987/real-time-trading-dashboard#readme",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "decimal.js": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
